    "faqs": {
        "title": "❓ Frequently Asked Questions (FAQs)",
        "subtitle": "Find quick answers to common questions about NOC applications",
        "breadcrumb": "FAQs",
        "stillHaveQuestions": "📞 Still have questions?",
        "contactSupport": "If you couldn't find the answer you're looking for, please visit our Contact & Helpline page to get in touch with our support team.",
        "btnDocs": "← Documents",
        "btnContact": "Contact Us →",
        "categories": {
            "application": "Application Process",
            "documents": "Documents",
            "payment": "Payment",
            "status": "Status & Tracking"
        },
        "q1": "How do I apply for a Groundwater NOC?",
        "a1": "Register on the portal, complete your profile, fill the NOC application form, upload required documents, and submit. You will receive an Application ID for tracking.",
        "q2": "Can I save my application as a draft?",
        "a2": "Yes, you can save your application at any stage and complete it later. Your progress is automatically saved.",
        "q3": "How long does the approval process take?",
        "a3": "Typically 18-27 working days for new NOC applications, and 7-11 days for renewals. See the Timelines page for detailed breakdown.",
        "q4": "Can I track my application status?",
        "a4": "Yes, login to your dashboard to see real-time status updates and any pending actions required from your side.",
        "q5": "What documents are required for NOC application?",
        "a5": "Identity proof, address proof, land ownership documents, site map, and project proposal. Visit the 'Required Documents' page for the complete list.",
        "q6": "What is the maximum file size for uploads?",
        "a6": "Each file should not exceed 5MB. Compress larger files before uploading.",
        "q7": "Can I submit scanned copies of documents?",
        "a7": "Yes, clear scanned copies in PDF or JPG format are acceptable. Ensure all text is legible.",
        "q8": "Do I need to submit original documents?",
        "a8": "No, digital copies are sufficient for online application. Originals may be verified during site inspection.",
        "q9": "What is the application fee?",
        "a9": "The fee varies based on the type of application and extraction capacity. You will see the exact amount during application submission.",
        "q10": "What payment methods are accepted?",
        "a10": "Credit/Debit cards, Net Banking, UPI, and Government Payment Gateways are supported.",
        "q11": "Is the fee refundable?",
        "a11": "Application fees are generally non-refundable. However, in case of double payment, refunds are processed within 15 working days.",
        "q12": "Do I have to pay before or after approval?",
        "a12": "Payment is required after initial document verification to proceed with site inspection and final approval.",
        "q13": "How do I check my application status?",
        "a13": "Login to your dashboard to see detailed status updates, current stage, and any pending actions.",
        "q14": "Will I receive email notifications?",
        "a14": "Yes, you will receive email alerts for major status changes, document requests, and approvals.",
        "q15": "What happens if my application is rejected?",
        "a15": "You will receive detailed reasons for rejection. You can correct the issues and submit the application again.",
        "q16": "Can I withdraw my application?",
        "a16": "Yes, you can withdraw before approval. However, processing fees are non-refundable."
    },
